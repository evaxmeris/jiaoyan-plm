/// 安全评估报告（CPSR）— 备案关联的安全评估记录
/// 根据《化妆品监督管理条例》和《化妆品安全评估技术导则》要求
model SafetyAssessment {
  id             String               @id @default(cuid())
  registrationId String
  registration   Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  assessor       String               // 评估机构
  assessDate     DateTime?            // 评估日期
  reportNo       String?              // 报告编号
  conclusion     AssessmentConclusion // 评估结论
  fileUrl        String?              // 报告文件URL
  remark         String?              // 备注
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([registrationId])
  @@map("safety_assessments")
}

enum AssessmentConclusion {
  PASS         // 通过
  CONDITIONAL  // 有条件通过
  FAIL         // 不通过
}

/// 化妆品合规 - 原料法规数据库
/// 存储中国化妆品禁用/限用/准用成分信息
/// 数据来源：《化妆品安全技术规范（2015年版）》及后续修订
model IngredientRegulation {
  id            String   @id @default(cuid())
  nameCn        String   // 中文名称
  nameEn        String?  // 英文名称
  inciName      String?  // INCI名称
  casNo         String?  // CAS号
  regulationType String // 禁用/限用/准用
  market        Market   @default(CHINA) // 适用市场
  maxConcentration Float? // 最大允许浓度（%）
  productTypeRestriction String? // 产品类型限制
  restrictionNote String? // 限制说明
  sourceRegulation String // 法规来源
  category       String? // 分类
  scope          String? // 适用范围（如"驻留类/淋洗类"）
  ingredientFunction String? // 原料功能（如"防腐剂/防晒剂/美白剂"）
  referenceFile  String? // 法规原文文件引用
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([casNo])
  @@index([nameCn])
  @@index([regulationType])
  @@index([ingredientFunction])
  @@index([scope])
  @@map("ingredient_regulations")
  @@unique([nameCn, market])
}

/// 多市场检测标准配置 — 不同目标市场对同一检测项目的标准限值
model ComplianceStandard {
  id             String   @id @default(cuid())
  market         Market   // 目标市场
  testItem       String   // 检测项目（MICROBIAL/PHYSICAL/STABILITY/SAFETY/EFFICACY/CHALLENGE/PACKAGING）
  standardValue  String   // 标准值/限值
  regulationRef  String?  // 法规依据（如《化妆品安全技术规范》2015版第X条）
  remark         String?  // 备注
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([market, testItem])
  @@index([market])
  @@index([testItem])
  @@map("compliance_standards")
}

enum RegulationType {
  PROHIBITED   // 禁用
  RESTRICTED   // 限用
  ALLOWED      // 准用
}

enum Market {
  CHINA
  EU
  US
  KSA
  JP
  KR
  MY
  PH
  RU
  GB
}

/// 化妆品合规 - 检测委托
model TestEntrustment {
  id              String           @id @default(cuid())
  registrationId  String?
  registration    Registration?    @relation(fields: [registrationId], references: [id])
  productDesignId String?
  product         ProductDesign?   @relation(fields: [productDesignId], references: [id])
  productName     String           // 送检产品名称
  type            String?          // 检测类型
  testItems       Json?            // 检测项目
  institution     String           // 检测机构
  reportNo        String?          // 报告编号
  reportUrl       String?          // 报告文件URL
  sampleBatch     String?          // 样品批号
  applyDate       DateTime?        // 申请日期
  sendDate        DateTime?        // 送检日期
  completeDate    DateTime?        // 完成日期
  reportDate      DateTime?        // 报告日期
  result          InspectionResult @default(PENDING) // 检测结果
  status          InspectionStatus @default(PENDING) // 检测状态
  cost            Float?           // 检测费用
  remark          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  @@index([registrationId])
  @@index([productDesignId])
  @@map("test_entrustments")
}

// 原料合规筛查 — 合规链条中的"原料筛查"环节
model IngredientCheck {
  id            String      @id @default(cuid())
  rawMaterialId String
  checkItem     String // 筛查项目: DISABLED_COMPONENT(禁用组分)/RESTRICTED_SUBSTANCE(限用物质)/ALLERGEN(过敏原)/PRESERVATIVE(防腐剂)/SUNSCREEN(防晒剂)/COLORANT(着色剂)
  referenceStd  String? // 参考标准 (如《化妆品安全技术规范》2015版)
  limitValue    String? // 限量值
  actualValue   String? // 实测值或配方中含量
  result        IQCResult   @default(PENDING) // PASS/CONDITIONAL/FAIL
  remark        String?
  checkedBy     String? // 筛查人
  checkedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
  @@map("ingredient_checks")
}

// model Inspection已迁移到 TestEntrustment，保留到下次清理
// InspectionResult 和 InspectionStatus 枚举仍被 TestEntrustment 共用
