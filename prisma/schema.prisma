model Patent {
  id              String             @id @default(cuid())
  name            String
  type            PatentType
  applicationNo   String?
  patentNo        String?
  inventor        String
  applicant       String
  applyDate       DateTime?
  grantDate       DateTime?
  expireDate      DateTime?
  status          PatentStatus       @default(DRAFT)
  techField       String?
  remark          String?
  // 扩展生命周期字段
  filingDate      DateTime? // 申请日（正式提交日）
  publicationDate DateTime? // 公开日
  agency          String? // 代理机构
  agentContact    String? // 代理人
  fee             Float? // 申请费
  filingReceipt   String? // 受理通知书URL
  patentCert      String? // 专利证书URL
  officeActions   Json? // 审查意见通知书 [{date, type, responseDate, status}]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean            @default(false)
  // attachments     PatentAttachment[] // 已迁移到 File 模型
  fees            PatentFee[]
  contractId      String? // 关联服务合同
  contract        ServiceContract?   @relation(fields: [contractId], references: [id])

  @@map("patents")
}

