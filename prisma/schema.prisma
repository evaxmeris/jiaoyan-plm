// ── 成本核算与定价 ──

/// CostingStatus - 成本核算状态
/// DRAFT — 草稿（可编辑）
/// FINAL — 已定稿（不可编辑）
enum CostingStatus {
  DRAFT
  FINAL
}

/// ProductCosting — 产品成本核算
/// 记录每批次产品的完整成本结构和建议定价
model ProductCosting {
  id               String        @id @default(cuid())
  productDesignId  String
  version          Int           @default(1) // 版本号，每次核算自动递增
  costingDate      DateTime      @default(now()) // 核算日期
  rawMaterialCost  Float         @default(0) // 原料成本（自动计算或手动填写）
  packagingCost    Float         @default(0) // 包材成本
  oemFee           Float         @default(0) // 代工费
  testingFee       Float         @default(0) // 检测费
  certificationFee Float         @default(0) // 备案/认证费
  otherCost        Float         @default(0) // 其他费用
  totalCost        Float         @default(0) // 总成本 = 原料+包材+代工+检测+认证+其他
  outputQty        Int           @default(0) // 产出数量（每批次）
  unitCost         Float         @default(0) // 单件成本 (totalCost / outputQty)
  targetMargin     Float?        @default(0) // 目标毛利率(%)
  suggestedPrice   Float         @default(0) // 建议零售价（自动 = unitCost / (1 - targetMargin/100)）
  actualPrice      Float? // 实际售价
  status           CostingStatus @default(DRAFT)
  remark           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)

  @@unique([productDesignId, version])
  @@map("product_costings")
}

/// PriceHistory — 售价变更记录
model PriceHistory {
  id              String        @id @default(cuid())
  productDesignId String
  price           Float // 售价
  effectiveDate   DateTime // 生效日期
  channel         String? // 渠道（如 天猫/Amazon/小红书）
  reason          String? // 变更原因
  createdAt       DateTime      @default(now())
  product         ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)

  @@map("price_histories")
}

// ── 分销管理 ──

enum ChannelType {
  PLATFORM
  DISTRIBUTOR
  RETAILER
  OFFLINE
  OTHER
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

model DistributionChannel {
  id             String        @id @default(cuid())
  name           String // 渠道名称，如 "天猫旗舰店"、"抖音小店"、"Amazon US"、"小红书店铺"、"线下经销商"
  type           ChannelType // PLATFORM/DISTRIBUTOR/RETAILER/OFFLINE/OTHER
  contact        String? // 联系人
  phone          String? // 联系电话
  commissionRate Float? // 佣金比例 %
  status         ChannelStatus @default(ACTIVE)
  remark         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orders         SalesOrder[]

  @@map("distribution_channels")
}

model SalesOrder {
  id             String              @id @default(cuid())
  orderNo        String              @unique // 订单号，自动生成
  channelId      String
  productId      String? // 关联产品
  productName    String // 产品名称（冗余方便显示）
  quantity       Int
  unitPrice      Float // 单价
  totalAmount    Float // 总金额
  orderDate      DateTime
  status         OrderStatus         @default(PENDING)
  trackingNo     String? // 物流单号
  remark         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  channel        DistributionChannel @relation(fields: [channelId], references: [id])
  shippingOrders ShippingOrder[]

  @@map("sales_orders")
}

enum ShippingStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

model ShippingOrder {
  id                String         @id @default(cuid())
  salesOrderId      String
  shippingNo        String         @unique // 运单号，自动生成 SO-{date}-{seq}
  logisticsProvider String? // 物流商名称
  trackingNo        String? // 物流单号
  shippingDate      DateTime? // 发货日期
  estimatedDays     Int? // 预计运输天数
  deliveredDate     DateTime? // 签收日期
  status            ShippingStatus @default(PENDING)
  totalPackage      Int? // 总件数
  weight            Float? // 重量(kg)
  volume            Float? // 体积(m³)
  shippingCost      Float? // 运费
  remark            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  salesOrder        SalesOrder     @relation(fields: [salesOrderId], references: [id])

  @@map("shipping_orders")
}

model LogisticsProvider {
  id        String   @id @default(cuid())
  name      String // 物流商名称
  contact   String? // 联系人
  phone     String? // 电话
  regions   Json? // 服务区域（Json数组）
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("logistics_providers")
}

/// 收货地址 — 管理常用收货地址（仓库地址、办公地址等）
model ShippingAddress {
  id        String   @id @default(cuid())
  label     String   // 地址标签，如"仓库地址""办公地址"
  receiver  String   // 收货人
  phone     String   // 联系电话
  province  String   // 省份
  city      String   // 城市
  district  String   // 区/县
  detail    String   // 详细地址
  isDefault Boolean  @default(false) // 是否默认地址
  remark    String?  // 备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_addresses")
}

/// 仓位区域 — 仓库的区域划分
model WarehouseZone {
  id          String   @id @default(cuid())
  name        String   // 区域名称，如"A区""常温库""冷藏库"
  description String?  // 区域描述
  remark      String?  // 备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  locations   WarehouseLocation[]

  @@map("warehouse_zones")
}

/// 仓位 — 区域下的具体仓位
model WarehouseLocation {
  id          String        @id @default(cuid())
  zoneId      String
  code        String        // 仓位编码，如"A-01""A-02"
  description String?       // 仓位描述
  isOccupied  Boolean       @default(false) // 是否被占用
  remark      String?       // 备注
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  zone        WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, code])
  @@map("warehouse_locations")
}
