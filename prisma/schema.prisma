generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  passwordHash     String
  name             String
  phone            String?
  avatar           String?
  role             Role                  @default(DEVELOPER)
  department       String?
  position         String?
  isActive         Boolean               @default(true)
  status           UserStatus            @default(PENDING_APPROVAL)
  approvedBy       String?
  approvedAt       DateTime?
  rejectReason     String?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  approvalRequests ApprovalRequest[]     @relation("ApprovalRequester")
  approvalItems    ApprovalItem[]        @relation("ApprovalItemApprover")
  applications     PurchaseApplication[]
  reimbursements   Reimbursement[]
  tradeSecrets     TradeSecret[]
  serviceContracts ServiceContract[]
  userPermissions  UserPermission[]

  @@map("users")
}

// 权限配置（覆盖硬编码的 OPERATION_ROLES 默认值）
model PermissionConfig {
  operation    String   @id
  allowedRoles String[]
  description  String
  updatedAt    DateTime @updatedAt

  @@map("permission_configs")
}

// 用户级权限覆盖（允许/拒绝特定操作，优先级高于角色权限）
model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  operation String // 同 OPERATION_ROLES 中的 key，如 'formula.create'
  granted   Boolean  @default(true) // true = 允许, false = 拒绝
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation])
  @@map("user_permissions")
}

model Trademark {
  id               String                @id @default(cuid())
  name             String
  type             TrademarkType
  category         String
  applicationNo    String?
  registrationNo   String?
  // 生命周期关键日期
  applyDate        DateTime? // 原：申请日 ← 保留兼容，映射到 filingDate
  registerDate     DateTime? // 原：注册日 ← 保留兼容
  expireDate       DateTime? // 原：有效期至
  filingDate       DateTime? // 申请日（商标局受理日）
  publicationDate  DateTime? // 初审公告日
  registrationDate DateTime? // 注册日（商标局核准注册日）
  renewalDate      DateTime? // 续展日
  // 代理信息
  agency           String? // 代理机构
  agentContact     String? // 代理人及联系方式
  // 费用
  fee              Float? // 申请费用
  // 文件凭证
  filingReceipt    String? // 受理通知书URL/文件ID
  registrationCert String? // 注册证URL/文件ID
  // 状态
  status           TrademarkStatus       @default(DRAFT)
  owner            String
  remark           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean               @default(false)
  productLinks     ProductTrademark[]
  // attachments      TrademarkAttachment[] // 已迁移到 File 模型
  contractId       String? // 关联服务合同
  contract         ServiceContract?      @relation(fields: [contractId], references: [id])

  @@map("trademarks")
}

