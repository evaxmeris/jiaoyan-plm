model RawMaterial {
  id                  String                    @id @default(cuid())
  nameCn              String
  nameEn              String?
  casNo               String?
  filingNo            String? // 备案号
  filingStatus        RecordStatus              @default(UNRECORDED) // 备案状态
  filingExpireDate    DateTime? // 备案有效期
  inciName            String? // INCI 英文名
  safetyInfoUrl       String? // 原料安全信息文件路径
  msdsUrl             String? // 安全数据表
  tdsUrl              String? // 技术数据表
  supplier            String?
  supplierId          String?
  function            String?
  specification       String?
  limitChina          String?
  limitEu             String?
  isActive            Boolean                   @default(true)
  safetyInfo          String?
  unit                String                    @default("kg")
  currentStock        Float                     @default(0)
  minStock            Float                     @default(0)
  remark              String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  isDeleted           Boolean                   @default(false)
  latestPrice         Float? // 最新采购单价
  formulaItems        FormulaItem[]
  purchaseItems       PurchaseApplicationItem[]
  inventoryItems      RawMaterialBatch[]
  incomingInspections IncomingInspection[]
  ingredientChecks    IngredientCheck[]
  priceHistories      RawMaterialPrice[]

  @@map("raw_materials")
}

/// RawMaterialPrice — 原料采购价格记录（自动从PO收货写入）
model RawMaterialPrice {
  id              String   @id @default(cuid())
  rawMaterialId   String
  price           Float    // 单价（采购时的 unitPrice）
  unit            String   @default("kg")
  supplier        String?  // 供应商名称
  purchaseOrderNo String?  // PO编号
  batchNo         String?  // 原料批次号
  recordedAt      DateTime @default(now()) // 记录时间（收货日期）
  createdAt       DateTime @default(now())
  rawMaterial     RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@map("raw_material_prices")
}

model RawMaterialBatch {
  id                  String               @id @default(cuid())
  rawMaterialId       String
  batchNo             String
  internalBatch       String
  quantity            Float
  receiptDate         DateTime
  expireDate          DateTime? // 批次保质期
  supplier            String
  coaUrl              String?
  status              BatchStatus          @default(IN_STOCK)
  remark              String?
  purchaseOrderId     String? // 关联采购订单（追溯来源）
  createdAt           DateTime             @default(now())
  productTraceItems   ProductTraceItem[]
  rawMaterial         RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  incomingInspections IncomingInspection[]

  @@map("raw_material_batches")
}

/// 物资（非原料类库存：实验用品、办公用品、设备、礼品等）
model Supply {
  id           String   @id @default(cuid())
  name         String   // 物资名称
  category     String   // LAB_SUPPLIES / EQUIPMENT / OFFICE_SUPPLIES / GIFTS / OTHER
  unit         String   @default("个")
  specification String? // 规格型号
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  supplier     String?
  remark       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  batches      SupplyBatch[]

  @@map("supplies")
}

/// 物资批次
model SupplyBatch {
  id          String   @id @default(cuid())
  supplyId    String
  batchNo     String   // 批次号/采购单号
  quantity    Float
  receiptDate DateTime // 入库日期
  expireDate  DateTime?
  supplier    String?
  remark      String?
  createdAt   DateTime @default(now())
  supply      Supply   @relation(fields: [supplyId], references: [id])

  @@map("supply_batches")
}

// 到货质检 - 原料到货后的质量检验流程
model IncomingInspection {
  id               String            @id @default(cuid())
  rawMaterialId    String
  batchId          String?
  supplierBatchNo  String
  quantityReceived Float
  unit             String
  receiptDate      DateTime
  coaVerified      Boolean           @default(false)
  coaResult        String?
  sampleQty        Float?
  sampleLocation   String?
  samplePerson     String?
  inspectionDate   DateTime?
  inspector        String?
  result           IQCResult         @default(PENDING)
  nonConformity    Json?
  disposition      Disposition?
  remark           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rawMaterial      RawMaterial       @relation(fields: [rawMaterialId], references: [id])
  batch            RawMaterialBatch? @relation(fields: [batchId], references: [id])

  @@map("incoming_inspections")
}

// 制程检验 - 生产过程中的质量控制
enum IPQCStage {
  PRODUCTION
  FILLING
  PACKAGING
  LABELING
}

enum IPQCResult {
  PENDING
  PASS
  CONDITIONAL
  FAIL
}

model IPQC {
  id              String        @id @default(cuid())
  productDesignId String
  oemContractId   String?
  batchNo         String
  stage           IPQCStage     @default(PRODUCTION)
  checkDate       DateTime?
  inspector       String?
  items           Json?
  result          IPQCResult    @default(PENDING)
  imageUrls       Json?
  remark          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         ProductDesign @relation(fields: [productDesignId], references: [id])
  oemContract     OEMContract?  @relation(fields: [oemContractId], references: [id])

  @@map("ipqc")
}

// 出厂检验 - 成品出货前的质量检验
enum OQCResult {
  PENDING
  PASS
  CONDITIONAL
  FAIL
}

enum OQCDisposition {
  PASS
  REWORK
  SCRAP
}

model OQC {
  id              String          @id @default(cuid())
  productDesignId String
  batchNo         String
  quantityTotal   Float           @default(0)
  quantitySampled Float           @default(0)
  checkDate       DateTime?
  inspector       String?
  result          OQCResult       @default(PENDING)
  items           Json?
  disposition     OQCDisposition?
  reportUrl       String?
  remark          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         ProductDesign   @relation(fields: [productDesignId], references: [id])

  @@map("oqc")
}

model Formula {
  id            String           @id @default(cuid())
  name          String
  code          String           @unique
  version       String           @default("V1.0")
  targetProduct String?
  batchSize     Float?
  totalCost     Float?
  status        FormulaStatus    @default(DEVELOPING)
  isCore        Boolean          @default(false)
  processParams String?
  remark        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean          @default(false)
  items         FormulaItem[]
  versions      FormulaVersion[]
  complianceSnapshots FormulaComplianceSnapshot[]
  products      ProductDesign[]

  @@map("formulas")
}

model FormulaItem {
  id            String      @id @default(cuid())
  formulaId     String
  rawMaterialId String
  percentage    Float
  weight        Float?
  cost          Float?
  orderIndex    Int
  remark        String?
  formulaId2    String?
  formula       Formula     @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("formula_items")
}

model FormulaVersion {
  id        String   @id @default(cuid())
  formulaId String
  version   String
  snapshot  Json
  changedBy String
  changeLog String
  createdAt DateTime @default(now())
  formula   Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@map("formula_versions")
}

/// 配方合规扫描快照 — 每次配方保存时自动记录合规扫描结果
/// 供配方列表/详情页直接读取，避免实时扫描开销
model FormulaComplianceSnapshot {
  id            String   @id @default(cuid())
  formulaId     String
  scanDate      DateTime @default(now())
  overallPass   Boolean  // true=全部通过, false=存在不合规（禁用或限用）
  summary       Json     // { total, passed, warned, failed }
  hasProhibited Boolean  // 是否含禁用成分
  hasRestricted Boolean  // 是否含限用成分
  createdAt     DateTime @default(now())

  formula Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@index([formulaId])
  @@map("formula_compliance_snapshots")
}

model ProductDesign {
  id              String                    @id @default(cuid())
  name            String
  brand           String?
  category        String?
  capacity        String?
  status          ProductStatus             @default(CONCEPT)
  formulaId       String?
  packagingBom    Json?
  designDoc       String?
  sampleBatch     String?
  launchDate      DateTime?
  remark          String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean                   @default(false)
  // inspections     Inspection[]
  testEntrustments TestEntrustment[]
  formula         Formula?                  @relation(fields: [formulaId], references: [id])
  trademarks      ProductTrademark[]
  purchaseItems   PurchaseApplicationItem[]
  registrations   Registration[]
  sampleTasks     SampleTask[]
  retainedSamples RetainedSample[]
  stabilityTests  StabilityTest[]
  certifications  ProductCertification[]
  efficacyClaims  EfficacyClaim[]
  milestones      ProductMilestone[]
  pilotRuns       PilotRun[]
  ipqc            IPQC[]
  oqc             OQC[]
  costings        ProductCosting[]
  priceHistories  PriceHistory[]
  productBatches  ProductBatch[]

  @@map("product_designs")
}

// 试产/中试管理 — 产品量产前的中试验证和批次管理
model PilotRun {
  id              String          @id @default(cuid())
  productDesignId String
  batchNo         String // 批次号，自动生成 PLT-2026-0001
  scale           String // 试产规模，如 "5kg", "20kg", "100kg"
  producer        String // 生产方（代工厂名称或内部）
  plannedDate     DateTime? // 计划试产日期
  completedDate   DateTime? // 实际完成日期
  status          PilotRunStatus  @default(PLANNED)
  result          PilotRunResult? // 试产结果
  yield           Float? // 得率(%)
  defects         Json? // 缺陷记录 [{item, severity, description, action}]
  remark          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         ProductDesign   @relation(fields: [productDesignId], references: [id])

  @@map("pilot_runs")
}

enum PilotRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PilotRunResult {
  PASS
  CONDITIONAL
  FAIL
}

model ProductTrademark {
  productId   String
  trademarkId String
  product     ProductDesign @relation(fields: [productId], references: [id], onDelete: Cascade)
  trademark   Trademark     @relation(fields: [trademarkId], references: [id], onDelete: Cascade)

  @@id([productId, trademarkId])
  @@map("product_trademarks")
}

model Registration {
  id           String                   @id @default(cuid())
  productId    String
  registerNo   String?
  registerType String
  applyDate    DateTime?
  approveDate  DateTime?
  expiryDate   DateTime?
  status       RegistrationStatus       @default(APPLYING)
  remark       String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean                  @default(false)
  testEntrustments TestEntrustment[]
  // attachments  RegistrationAttachment[] // 已迁移到 File 模型
  assessments  SafetyAssessment[]
  documents    RegistrationDocument[]
  product      ProductDesign            @relation(fields: [productId], references: [id])

  @@map("registrations")
}

model RegistrationDocument {
  id             String          @id @default(cuid())
  registrationId String
  registration   Registration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String          // 材料名称（如"配方表""工艺简述""标签样稿""检测报告"等）
  required       Boolean         @default(true) // 是否必需
  status         DocumentStatus  @default(PENDING)
  submitDate     DateTime?
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("registration_documents")
}

enum DocumentStatus {
  PENDING    // 待提交
  SUBMITTED  // 已提交
  RETURNED   // 已退回
}

