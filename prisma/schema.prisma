// 功效宣称管理
enum ClaimCategory {
  STANDARD // 国标功效
  NEW      // 新功效
}

enum ClaimStatus {
  DRAFT
  REVIEWING
  APPROVED
  REJECTED
}

model EfficacyClaim {
  id              String         @id @default(cuid())
  productDesignId String?
  product         ProductDesign? @relation(fields: [productDesignId], references: [id])
  claimName       String         // 宣称名称（如"美白""保湿""抗皱""舒缓"等）
  category        ClaimCategory  @default(STANDARD) // 国标宣称/新功效
  status          ClaimStatus    @default(DRAFT)
  evidence        String?        // 支持证据（检测报告编号/文献引用）
  testEntrustmentId String?      // 关联的检测委托
  remark          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("efficacy_claims")
}

model Supplier {
  id                   String                @id @default(cuid())
  name                 String
  type                 SupplierType
  contact              String?
  phone                String?
  email                String?
  address              String?
  license              String?
  qualification        String?
  rating               Float?
  contractUrl          String?
  contractEnd          DateTime?
  isActive             Boolean               @default(true)
  remark               String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  isDeleted            Boolean               @default(false)
  oemContracts         OEMContract[]
  purchaseApplications PurchaseApplication[]
  documents            SupplierDocument[]
  audits               SupplierAudit[]
  evaluations          SupplierEvaluation[]

  @@map("suppliers")
}

model OEMContract {
  id             String            @id @default(cuid())
  supplierId     String
  contractNo     String            @unique
  productName    String
  techStandard   String?
  unitPrice      Float
  moq            Int
  leadTime       Int
  startDate      DateTime
  endDate        DateTime
  contractUrl    String?
  status         ContractStatus    @default(ACTIVE)
  remark         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean           @default(false)
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  priceHistories OemPriceHistory[]
  schedules      OemSchedule[]
  ipqc           IPQC[]

  @@map("oem_contracts")
}

model OemPriceHistory {
  id            String      @id @default(cuid())
  contractId    String
  productName   String
  unitPrice     Float
  moq           Int?
  effectiveDate DateTime
  remark        String?
  createdAt     DateTime    @default(now())
  contract      OEMContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("oem_price_history")
}

model OemSchedule {
  id            String         @id @default(cuid())
  contractId    String
  productName   String
  orderQty      Int
  plannedDate   DateTime
  completedDate DateTime?
  status        ScheduleStatus @default(PLANNED)
  remark        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contract      OEMContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("oem_schedules")
}

enum ScheduleStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

model SupplierDocument {
  id         String          @id @default(cuid())
  supplierId String
  type       SupplierDocType
  name       String
  fileUrl    String?
  issueDate  DateTime?
  expireDate DateTime?
  notifyDays Int             @default(30)
  status     DocStatus       @default(VALID)
  remark     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_documents")
}

model SupplierAudit {
  id         String      @id @default(cuid())
  supplierId String
  auditDate  DateTime
  auditor    String
  result     AuditResult
  score      Float?
  reportUrl  String?
  findings   Json?
  remark     String?
  createdAt  DateTime    @default(now())
  supplier   Supplier    @relation(fields: [supplierId], references: [id])

  @@map("supplier_audits")
}

model SupplierEvaluation {
  id            String   @id @default(cuid())
  supplierId    String
  evalDate      DateTime
  scoreQuality  Float
  scoreDelivery Float
  scoreService  Float
  scoreTotal    Float
  grade         String?  @default("C")
  evaluator     String
  remark        String?
  createdAt     DateTime @default(now())
  supplier      Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_evaluations")
}

model ProductBatch {
  id                   String                @id @default(cuid())
  productId            String
  batchNo              String                @unique
  productionDate       DateTime
  expireDate           DateTime?
  quantity             Int
  minStock             Int                   @default(0)
  status               BatchStatus           @default(IN_STOCK)
  registrationNo       String?
  remark               String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  isDeleted            Boolean               @default(false)
  traceItems           ProductTraceItem[]
  antiCounterfeitCodes AntiCounterfeitCode[]
  stockOutRecords      StockOutRecord[]
  product              ProductDesign         @relation(fields: [productId], references: [id])

  @@map("product_batches")
}

/// 成品出库记录
model StockOutRecord {
  id            String         @id @default(cuid())
  batchId       String
  quantity      Int
  reason        StockOutReason
  operatorName  String
  remark        String?
  createdAt     DateTime       @default(now())
  batch         ProductBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("stock_out_records")
}

enum StockOutReason {
  SALE
  DAMAGE
  RECALL
  GIFT
  OTHER
}

model ProductTraceItem {
  id                 String           @id @default(cuid())
  productBatchId     String
  rawMaterialBatchId String
  usagePercentage    Float?
  remark             String?
  productBatch       ProductBatch     @relation(fields: [productBatchId], references: [id], onDelete: Cascade)
  rawMaterialBatch   RawMaterialBatch @relation(fields: [rawMaterialBatchId], references: [id])

  @@map("product_trace_items")
}

model PurchaseApplication {
  id             String                    @id @default(cuid())
  code           String                    @unique
  applicantId    String
  title          String
  supplier       String?
  supplierId     String?
  totalAmount    Decimal                   @default(0)
  status         PurchaseStatus            @default(PENDING)
  urgency        Urgency                   @default(NORMAL)
  category       String                    @default("RAW_MATERIAL") // 采购分类: RAW_MATERIAL/LAB_SUPPLIES/EQUIPMENT/OFFICE_SUPPLIES/GIFTS/OTHER
  purpose        String
  relatedProject String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean                   @default(false)
  items          PurchaseApplicationItem[]
  purchaseOrder  PurchaseOrder?
  reimbursements Reimbursement[]
  applicant      User                      @relation(fields: [applicantId], references: [id])
  supplierR      Supplier?                 @relation(fields: [supplierId], references: [id])

  @@map("purchase_applications")
}

model PurchaseApplicationItem {
  id              String              @id @default(cuid())
  applicationId   String
  productDesignId String?
  rawMaterialId   String?
  name            String
  specification   String?
  quantity        Float
  unit            String
  estimatedPrice  Decimal
  totalPrice      Decimal
  remark          String?
  application     PurchaseApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product         ProductDesign?      @relation(fields: [productDesignId], references: [id])
  rawMaterial     RawMaterial?        @relation(fields: [rawMaterialId], references: [id])

  @@map("purchase_application_items")
}

/// 采购订单状态
enum PurchaseOrderStatus {
  DRAFT // 草稿
  ISSUED // 已发出
  CONFIRMED // 供应商已确认
  PARTIAL // 部分到货
  COMPLETED // 已完成
  CANCELLED // 已取消
}

/// 采购订单（PO）— 从审批通过的采购申请生成
model PurchaseOrder {
  id            String              @id @default(cuid())
  poNo          String              @unique // PO编号，自动生成 PO-2026-0001
  applicationId String              @unique // 关联采购申请（一对一）
  supplierId    String? // 供应商ID
  supplierName  String // 供应商名称（冗余）
  totalAmount   Float               @default(0) // 订单总额
  status        PurchaseOrderStatus @default(DRAFT)
  issuedAt      DateTime? // 发出日期
  confirmedAt   DateTime? // 供应商确认日期
  completedAt   DateTime? // 完成日期
  remark        String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  items         PurchaseOrderItem[]
  application   PurchaseApplication @relation(fields: [applicationId], references: [id])

  @@map("purchase_orders")
}

/// 采购订单明细
model PurchaseOrderItem {
  id            String        @id @default(cuid())
  orderId       String
  name          String
  rawMaterialId String?
  quantity      Float
  receivedQty   Float         @default(0) // 已收货数量
  unit          String
  unitPrice     Float         @default(0)
  totalPrice    Float         @default(0)
  remark        String?
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model ApprovalFlow {
  id        String   @id @default(cuid())
  name      String // 流程名称，如 "采购审批流程"
  module    String   @default("purchase") // 所属模块
  stages    Json // 审批阶段配置
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("approval_flows")
}

/// 审批请求状态
enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

/// 通用审批请求 - 支持采购、报销、商标、专利、合同等多种业务
model ApprovalRequest {
  id          String                @id @default(cuid())
  entityType  String // 'PurchaseApplication','Reimbursement','Patent','Trademark','ServiceContract','Payment'
  entityId    String
  title       String // 审批标题，如 "S²R 商标注册申请审批"
  amount      Float? // 涉及金额
  requesterId String
  status      ApprovalRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  requester   User                  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approvals   ApprovalItem[]

  @@index([entityType, entityId])
  @@index([requesterId])
  @@index([status])
  @@map("approval_requests")
}

/// 审批节点 - 每个审批请求的逐级审批记录
model ApprovalItem {
  id         String          @id @default(cuid())
  requestId  String
  level      Int // 审批层级，从1开始
  role       String? // 审批角色
  approverId String?
  action     ApprovalAction  @default(PENDING)
  comment    String?
  createdAt  DateTime        @default(now())
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User?           @relation("ApprovalItemApprover", fields: [approverId], references: [id])

  @@index([requestId])
  @@index([approverId])
  @@map("approval_items")
}

model Budget {
  id          String   @id @default(cuid())
  department  String
  fiscalYear  Int
  totalAmount Decimal  @default(0)
  usedAmount  Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories     BudgetCategory[]
  transactions   BudgetTransaction[]

  @@unique([department, fiscalYear])
  @@map("budgets")
}

/// 预算科目 — 每个预算下按用途细分的科目（如"原料采购""包装材料""检测费用""办公费用"等）
model BudgetCategory {
  id              String   @id @default(cuid())
  budgetId        String
  name            String   // 科目名称，如"原料采购""包装材料""检测费用""办公费用"
  allocatedAmount Decimal  @default(0) // 科目分配金额
  usedAmount      Decimal  @default(0) // 科目已使用金额（自动累计）
  sortOrder       Int      @default(0)
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budget       Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transactions BudgetTransaction[]

  @@unique([budgetId, name])
  @@map("budget_categories")
}

/// 预算执行明细 — 每笔支出记录（关联到预算和科目）
model BudgetTransaction {
  id              String   @id @default(cuid())
  budgetId        String
  categoryId      String?  // 关联科目（可选）
  amount          Decimal  @default(0) // 支出金额
  type            String   @default("EXPENSE") // EXPENSE / REIMBURSEMENT / PAYMENT
  description     String   // 支出说明
  referenceType   String?  // 关联业务类型：PurchaseApplication / Reimbursement / ServiceContract
  referenceId     String?  // 关联业务ID
  transactionDate DateTime @default(now()) // 交易日期
  createdBy       String?  // 创建人ID
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budget   Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([categoryId])
  @@index([referenceType, referenceId])
  @@map("budget_transactions")
}

model Reimbursement {
  id                    String               @id @default(cuid())
  code                  String               @unique
  applicantId           String
  amount                Decimal
  receipts              Json?
  description           String
  status                ReimbursementStatus  @default(DRAFT)
  purchaseApplicationId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  isDeleted             Boolean              @default(false)
  applicant             User                 @relation(fields: [applicantId], references: [id])
  purchaseApplication   PurchaseApplication? @relation(fields: [purchaseApplicationId], references: [id])

  @@map("reimbursements")
}

model SampleTask {
  id              String        @id @default(cuid())
  productDesignId String
  batchNo         String
  quantity        Int
  result          String?
  evaluation      String?
  nextAction      String?
  status          SampleStatus  @default(PENDING)
  assignedTo      String?
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  remark          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean       @default(false)
  product         ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)

  @@map("sample_tasks")
}

// 留样记录 — 法规要求的成品留样管理
model RetainedSample {
  id                 String               @id @default(cuid())
  productDesignId    String
  batchNo            String // 批次号
  quantity           Int // 留样数量
  storageLocation    String? // 留样位置（如：留样室A-3-2）
  sampleDate         DateTime // 留样日期
  expireDate         DateTime? // 保质期（到期日）
  status             RetainedSampleStatus @default(NORMAL) // NORMAL / EXPIRING / EXPIRED
  observationRecords Json? // 观察记录 [{ date: "2026-01-15", result: "NORMAL", images: ["url1"], remark: "..." }]
  remark             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  isDeleted          Boolean              @default(false)
  product            ProductDesign        @relation(fields: [productDesignId], references: [id])

  @@index([productDesignId])
  @@index([status])
  @@index([expireDate])
  @@map("retained_samples")
}

enum RetainedSampleStatus {
  NORMAL
  EXPIRING
  EXPIRED
}

// 稳定性跟踪 — 加速/长期/挑战测试
model StabilityTest {
  id              String              @id @default(cuid())
  productDesignId String
  batchNo         String // 批次号
  testType        StabilityTestType // ACCELERATED / LONG_TERM / CHALLENGE
  startDate       DateTime // 开始日期
  endDate         DateTime? // 结束日期（预计完成）
  interval        Int                 @default(1) // 观察间隔（月）
  status          StabilityTestStatus @default(IN_PROGRESS) // IN_PROGRESS / COMPLETED / FAILED
  records         Json? // 各时间点观察记录 [{ month: 0, date: "...", result: "NORMAL", description: "...", images: ["url1"] }]
  remark          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean             @default(false)
  product         ProductDesign       @relation(fields: [productDesignId], references: [id])

  @@index([productDesignId])
  @@index([status])
  @@map("stability_tests")
}

enum StabilityTestType {
  ACCELERATED
  LONG_TERM
  CHALLENGE
}

enum StabilityTestStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// 产品合规认证 - 跟踪产品在各市场的注册/认证/宣称进度
model ProductCertification {
  id              String        @id @default(cuid())
  productDesignId String
  market          String // CN/US/EU/JP/OTHER
  certType        String // REGISTRATION/CERTIFICATION/LABEL_CLAIM
  certName        String
  certNo          String?
  status          CertStatus    @default(PENDING)
  applyDate       DateTime?
  approveDate     DateTime?
  expiryDate      DateTime?
  remark          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         ProductDesign @relation(fields: [productDesignId], references: [id])

  @@map("product_certifications")
}

// 产品开发里程碑 - 记录产品开发进度的关键节点完成情况
model ProductMilestone {
  id              String        @id @default(cuid())
  productDesignId String
  stage           String // CONCEPT_REVIEW/FORMULA_FINALIZED/PACKAGING_CONFIRMED/SAMPLE_CONFIRMED/EFFICACY_COMPLETED/REGISTRATION_COMPLETED/COMPLIANCE_READY/PRODUCTION_READY
  label           String
  completed       Boolean       @default(false)
  completedAt     DateTime?
  completedBy     String?
  remark          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         ProductDesign @relation(fields: [productDesignId], references: [id], onDelete: Cascade)

  @@unique([productDesignId, stage])
  @@map("product_milestones")
}

// 产品防伪码 - S²R/QEVORIA 品牌产品真伪验证
enum AntiCounterfeitStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  REVOKED
}

model AntiCounterfeitCode {
  id              String                @id @default(cuid())
  code            String                @unique // 防伪码
  productBatchId  String? // 关联生产批次
  productId       String? // 关联产品
  status          AntiCounterfeitStatus @default(ACTIVE)
  firstVerifiedAt DateTime? // 首次验证时间
  firstVerifiedIp String? // 首次验证IP
  verifyCount     Int                   @default(0)
  createdAt       DateTime              @default(now())
  expiredAt       DateTime? // 有效期
  batch           ProductBatch?         @relation(fields: [productBatchId], references: [id])

  @@index([code])
  @@map("anti_counterfeit_codes")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model PatentFee {
  id       String          @id @default(cuid())
  patentId String
  year     Int
  amount   Float
  dueDate  DateTime
  paidDate DateTime?
  status   PatentFeeStatus @default(PENDING)
  remark   String?
  patent   Patent          @relation(fields: [patentId], references: [id], onDelete: Cascade)

  @@map("patent_fees")
}

// 服务合同 - 翻译/法务/咨询/检测/其他
enum ServiceContractType {
  TRANSLATION
  LEGAL
  CONSULTING
  TESTING
  OTHER
}

enum ServiceContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  TERMINATED
}

model ServiceContract {
  id          String                   @id @default(cuid())
  name        String // 合同名称
  contractor  String // 服务方
  type        ServiceContractType // TRANSLATION/LEGAL/CONSULTING/TESTING/OTHER
  amount      Float // 合同金额
  signingDate DateTime // 签署日期
  startDate   DateTime? // 生效日期
  endDate     DateTime? // 结束日期
  status      ServiceContractStatus    @default(DRAFT)
  fileUrl     String? // 合同文件URL
  isDeleted   Boolean                  @default(false)
  deletedAt   DateTime?
  remark      String? // 备注
  applicantId String // 申请人
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  applicant   User                     @relation(fields: [applicantId], references: [id])
  payments    ServiceContractPayment[]
  trademarks  Trademark[] // 关联的商标申请
  patents     Patent[] // 关联的专利申请

  @@map("service_contracts")
}

model ServiceContractPayment {
  id          String          @id @default(cuid())
  contractId  String
  amount      Float // 本次支付金额
  paymentDate DateTime // 支付日期
  method      String? // BANK_TRANSFER / ALIPAY / WECHAT / CASH / CHECK
  remark      String? // 备注
  createdAt   DateTime        @default(now())
  contract    ServiceContract @relation(fields: [contractId], references: [id])

  @@map("service_contract_payments")
}

/// 业务流程节点 — 记录每个业务阶段的进度、文件、完成时间
/// 多态关联（entityType+entityId），不设外键约束
model ProcessMilestone {
  id          String    @id @default(cuid())
  entityType  String // 'Trademark' / 'Patent' / 'ServiceContract' / 'ProductDesign'
  entityId    String
  stage       String // 节点标识
  label       String // 节点显示名
  status      String // PENDING / IN_PROGRESS / COMPLETED / SKIPPED / FAILED
  completedAt DateTime?
  remark      String? // 备注
  fileUrls    Json? // 关联文件URL列表
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([entityType, entityId, stage])
  @@index([entityType, entityId])
  @@map("process_milestones")
}

model TradeSecret {
  id        String           @id @default(cuid())
  title     String
  content   String // Base64 encrypted
  summary   String?
  level     TradeSecretLevel @default(CONFIDENTIAL)
  createdBy String
  creator   User             @relation(fields: [createdBy], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  isDeleted Boolean          @default(false)

  @@map("trade_secrets")
}

// 统一文件系统 - 通用文件存储，支持所有实体类型的附件上传
model File {
  id           String    @id @default(cuid())
  name         String
  originalName String
  url          String
  mimeType     String
  size         Int
  entityType   String // 'Trademark','Patent','Registration','Supplier','SupplierAudit','IncomingInspection','RawMaterial','OEMContract','ProductDesign'
  entityId     String
  fileType     String? // 'COA','MSDS','TDS','LICENSE','NDA','REPORT','CERT','LABEL','PACKAGING','DESIGN' 等
  expireDate   DateTime?
  uploadedBy   String?
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)

  @@index([entityType, entityId])
  @@index([fileType])
  @@map("files")
}

