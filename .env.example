# 交研生物 PLM - 环境变量配置

# 必须设置：JWT 签名密钥（生产环境请使用高强度随机字符串）
# 生成命令：openssl rand -hex 64
JWT_SECRET=your-super-secret-key-change-this-in-production

# 数据库连接
DATABASE_URL=postgresql://user:password@localhost:5432/jiaoyan-plm

# Sentry 错误监控（可选，不设置则静默降级）
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=jiaoyan-plm
SENTRY_AUTH_TOKEN=your-auth-token

# 服务端口
PORT=3002
